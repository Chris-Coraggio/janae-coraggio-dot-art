# Gallery images — immutable, 1-year cache
# Filenames are content-addressed (change slug = new URL), so this is safe.
/assets/img/gallery/*
  Cache-Control: public, max-age=31536000, immutable

# Other images — long cache but revalidatable
/assets/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# CSS / JS — long cache (cache-busted by Jekyll's bust_file_cache filter)
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
