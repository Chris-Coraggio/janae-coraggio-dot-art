{% comment %}
  Renders the description for a book, pulling from Sanity if available.
  Usage: {% include book_description.liquid slug="the-happy-field" %}
{% endcomment %}

{% assign _book = site.data.sanity.books | where: 'slug', include.slug | first %}
<div class="book-description mt-4 mb-5">
  {% if _book and _book.description_html %}
    {{ _book.description_html }}
  {% else %}
    <p><em>Description coming soon.</em></p>
  {% endif %}
</div>
