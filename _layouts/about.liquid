---
layout: default
---
<style>
  .header-flex-container {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .header-flex-container {
      flex-direction: column;
      align-items: center;
    }

    .header-flex-container .logo {
      display: flex;
      justify-content: center;
      width: 100%;
    }
  }
</style>
<div class="post">
  <header class="post-header">
    <div class="header-flex-container">
      {% if page.profile.logo %}
        {% assign logo_path = page.profile.logo | prepend: 'assets/img/' %}
        <div class="logo" style="flex-shrink: 0;">
          {%
            include figure.liquid loading="eager" path=logo_path class="img-fluid" sizes="144px" alt="Logo"
            cache_bust=true
          %}
        </div>
      {% endif %}
      <div style="flex: 1; min-width: 200px;">
        <h3 class="post-title">
          {% if site.title == 'blank' %}
            <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
            {{ site.last_name }}
          {% else %}
            {{ site.title }}
          {% endif %}
        </h3>
        <p class="desc">{{ page.subtitle }}</p>
      </div>
    </div>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">
      {%- if site.data.sanity.about.bio_html -%}
        {{ site.data.sanity.about.bio_html }}
      {%- else -%}
        {{ content }}
      {%- endif -%}
    </div>

    <!-- Features Card -->
    <div class="card mt-4 mb-4">
      <div class="card-body">
        <h4 class="card-title font-weight-bold mb-3">Features</h4>
        {% if site.data.sanity.about.features_html %}
          {{ site.data.sanity.about.features_html }}
        {% else %}
          <ul class="mb-0">
            <li>
              2026 presenter at the American Art Therapy Association (AATA) Annual Conference on &ldquo;Bibliotherapy and Art Therapy: The Power of
              Picture Books Across All Ages&rdquo;
            </li>
            <li>
              Concept Artist for a
              <a href="https://www.marlerblog.com/case-news/colonel-colon-and-his-league-of-fecal-fighters/" target="_blank" rel="noopener noreferrer"
                >Food Safety Law project</a
              >
            </li>
          </ul>
        {% endif %}
      </div>
    </div>

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      <div id="newsletter-signup">
        {% if site.contact_note %}
          <div class="contact-note" style="text-align: center; margin-bottom: 0.5rem;">{{ site.contact_note }}</div>
        {% endif %}
        {% include newsletter.liquid center=true %}
      </div>
    {% endif %}
  </article>
</div>
